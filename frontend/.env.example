# Frontend configuration — copy to .env.local and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put a secret in this file: everything here ships to every visitor.

# Canonical public origin of the deployed site.
# Used for <link rel="canonical">, Open Graph/Twitter URLs, the sitemap and the
# sitemap link inside robots.txt. Must be the final HTTPS domain with no path:
# the institution's official domain is https://pandemicintelcenter.org — never a
# preview or vercel.app host, or those URLs get indexed instead of the official
# domain. See docs/DEPLOYMENT.md.
VITE_SITE_URL=https://pandemicintelcenter.org

# Base URL of the deployed backend API, no trailing slash
# (the Render service origin is what the current deployment uses).
VITE_API_BASE_URL=https://api.example.org

# Set to "true" on staging builds to surface React error boundaries instead of
# a blank screen.
VITE_SHOW_ERRORS=false
