# Backend API configuration — copy to .env and fill in real values.
# NEVER commit a filled-in .env; it is already git-ignored.

# Node runtime
NODE_ENV=development
PORT=10000

# REQUIRED. Signs admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every admin session.
JWT_SECRET=

# REQUIRED only for the very first boot, when the admins table is empty.
# The admin is created once, then these can be cleared.
# Use a long random password — never reuse it anywhere else.
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=

# Comma-separated list of origins allowed to call this API from a browser.
# Must include the deployed frontend origin(s). Requests from other origins
# are rejected by CORS, so include every preview domain you use.
FRONTEND_URL=https://www.example.org

# Salt for hashing visitor IPs in contact enquiries. Optional; falls back to
# JWT_SECRET. Set it to any long random string so rotating JWT_SECRET does not
# change existing hashes.
IP_HASH_SALT=

# Where the SQLite database lives. Defaults to ./data/cghi.db.
# On Render, mount a disk at /opt/render/project/src/backend/data, otherwise
# every deploy discards the content managed through /admin.
# DB_PATH=
